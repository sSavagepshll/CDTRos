# Copy to .env and replace all example values before starting.
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_EMAIL=team@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-of-at-least-12-characters

POSTGRES_DB=product_requests
POSTGRES_USER=product_requests
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# SMTP_FROM is the sender only. Team alerts go to ADMIN_EMAIL;
# confirmations go to the requester's email address.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=1
SMTP_USE_SSL=0

# The HTTPS proxy serves the application at https://localhost:8443.
COOKIE_SECURE=1
# Enable HSTS only when using a certificate trusted by all clients.
HSTS_ENABLED=0
